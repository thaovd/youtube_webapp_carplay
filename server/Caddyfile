# HTTP nội bộ, nhận từ reverse proxy ngoài (nginx) đã có TLS. Không tự cấp chứng chỉ.
{
	auto_https off
}

:8090 {
	encode gzip

	# ---- App CarTube phục vụ tại /yt/ (mã nguồn repo mount vào /app, cập nhật bằng git pull) ----
	handle_path /yt/* {
		root * /app
		header Cache-Control "no-cache"
		file_server
	}
	redir /yt /yt/ 301

	# ---- API Invidious ----

	# CORS cho API JSON, manifest DASH, phụ đề và luồng video (dash.js tải bằng fetch, có header Range -> preflight OPTIONS)
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Range, Content-Type, If-Range, Accept, Accept-Encoding"
		Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
		Access-Control-Max-Age "86400"
		-Server
	}
	# Preflight trả lời ngay (trước bộ lọc, vì preflight không mang Referer)
	@options method OPTIONS
	respond @options 204

	# Chỉ cho phép app của bạn dùng máy chủ (theo Origin hoặc Referer). Đặt ALLOWED_REFERER=.* để mở cho mọi nguồn.
	@blocked {
		not header_regexp Origin ^{$ALLOWED_REFERER}
		not header_regexp Referer ^{$ALLOWED_REFERER}
		not path /api/v1/stats
	}
	respond @blocked "Forbidden" 403

	reverse_proxy invidious:3000 {
		header_up X-Forwarded-Proto https
		flush_interval -1
	}
}
